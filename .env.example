# Browser-safe values copied into js/config.js for local static hosting
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function secrets — never expose these in browser code
# Use mock only for an explicitly labelled development test. Production must be live.
CALL_MODE=live
SARVAM_API_KEY=YOUR_ROTATED_SARVAM_API_KEY
SARVAM_ORG_ID=YOUR_SARVAM_ORG_ID
SARVAM_WORKSPACE_ID=YOUR_SARVAM_WORKSPACE_ID
SARVAM_APP_ID=YOUR_SARVAM_APP_ID
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=YOUR_SARVAM_CONNECTION_ID
SARVAM_AGENT_PHONE_NUMBER=YOUR_CONNECTED_OUTBOUND_PHONE_NUMBER
SARVAM_WEBHOOK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/sarvam-call-webhook
SARVAM_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Optional: use a Sarvam Model API key with Translate API access when the Voice Agents key cannot translate transcripts.
SARVAM_TRANSLATION_API_KEY=
